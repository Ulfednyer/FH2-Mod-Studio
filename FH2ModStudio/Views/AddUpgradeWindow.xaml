<Window TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Auto" UseLayoutRounding="True" SnapsToDevicePixels="True" x:Class="FH2ModStudio.Views.AddUpgradeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add upgrade" Height="600" Width="860" MinHeight="480" MinWidth="720"
        WindowStyle="None" AllowsTransparency="False" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="-1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <DataTemplate x:Key="DonorTemplate">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="#1C1C1E"/>
                    <Border CornerRadius="8" Padding="6,1" Margin="8,0,0,0" Background="#2034C759" BorderBrush="#6034C759" BorderThickness="1">
                        <TextBlock Text="Recommended" FontSize="10" FontWeight="SemiBold" Foreground="#1E8E3E"/>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Recommended}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#636366" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Border BorderThickness="1">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#90FFFFFF" Offset="0"/>
                <GradientStop Color="#20FFFFFF" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border Background="#E6F6F8FA">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Title bar -->
                <Border Grid.ColumnSpan="2" MouseDown="TitleBar_MouseDown" BorderThickness="0,0,0,1" BorderBrush="#30000000">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#D8FFFFFF" Offset="0"/>
                            <GradientStop Color="#B0FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <TextBlock x:Name="TitleTxt" Text="Add upgrade" FontSize="13" FontWeight="SemiBold" Foreground="#1C1C1E" VerticalAlignment="Center" Margin="16,0"/>
                        <Button HorizontalAlignment="Right" Width="32" Height="24" Margin="0,0,8,0" Click="Cancel_Click" BorderThickness="0"
                                Background="Transparent" FocusVisualStyle="{x:Null}" ToolTip="Close">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="R" CornerRadius="4" Background="Transparent">
                                        <Viewbox Width="10" Height="10">
                                            <Path Stroke="#FF3B30" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M0,0 L10,10 M10,0 L0,10"/>
                                        </Viewbox>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="R" Property="Background" Value="#18FF3B30"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Categories -->
                <Border Grid.Row="1" Grid.RowSpan="2" BorderThickness="0,0,1,0" BorderBrush="#30000000">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#B8FFFFFF" Offset="0"/>
                            <GradientStop Color="#98FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <ListBox x:Name="KindList" Margin="10,12,10,12" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource MacroListItem}" SelectionChanged="KindList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="#1C1C1E"/>
                                    <TextBlock Text="{Binding Hint}" FontSize="10" Foreground="#6E6E73" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Options for the chosen kind (built in code) -->
                <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
                    <StackPanel x:Name="OptionsPanel"/>
                </ScrollViewer>

                <!-- Preview + actions -->
                <Border Grid.Row="2" Grid.Column="1" BorderThickness="0,1,0,0" BorderBrush="#25000000" Padding="16,10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#D8FFFFFF" Offset="0"/>
                            <GradientStop Color="#B8FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="DoneTxt" FontSize="12" FontWeight="SemiBold" Foreground="#1E8E3E" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,2"/>
                            <TextBlock x:Name="PreviewTxt" FontSize="12" Foreground="#48484A" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="CancelBtn" Grid.Column="1" Content="Cancel" Style="{StaticResource GlassBtn}" Click="Cancel_Click"/>
                        <Button x:Name="AddBtn" Grid.Column="2" Content="Add upgrade" Style="{StaticResource GlassBtnPrimary}" Padding="22,8" Click="Add_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
