<UserControl x:Class="FH2ModStudio.Views.DatabaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════ TABLE LIST (sub-panel) ═══════════ -->
        <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="#30000000">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#B8FFFFFF" Offset="0"/>
                    <GradientStop Color="#98FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="0,12,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid Margin="14,0,14,8">
                    <TextBlock Text="Tables" FontSize="14" FontWeight="Bold" Foreground="#1C1C1E"/>
                    <TextBlock x:Name="TableCountTxt" FontSize="11" Foreground="#8E8E93" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <Grid Grid.Row="1" Margin="12,0,12,8">
                    <TextBox x:Name="SearchBox" Style="{StaticResource GlassTextBox}" FontSize="12" Padding="10,6" TextChanged="SearchBox_TextChanged"/>
                    <TextBlock x:Name="SearchHint" Text="Search tables or columns (e.g. Turbo)" FontSize="12" Foreground="#8E8E93"
                               Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <ListBox x:Name="TableList" Grid.Row="2" Margin="10,0,10,0" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource MacroListItem}" SelectionChanged="TableList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#1C1C1E" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Hint}" FontSize="10" Foreground="#8E8E93" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Hint}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!-- Offline overlay -->
                <Border x:Name="OfflinePanel" Grid.Row="1" Grid.RowSpan="2" Margin="12,0" Visibility="Collapsed" Style="{StaticResource GlassCardSm}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Database offline" FontSize="13" FontWeight="Bold" Foreground="#1C1C1E" Margin="0,0,0,4"/>
                        <TextBlock x:Name="OfflineTxt" Style="{StaticResource BodyTxt}"/>
                        <Button Content="Go to Home" Style="{StaticResource GlassBtn}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="GoHome_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════ WORKSPACE ═══════════ -->
        <Grid Grid.Column="1" Margin="12,10,12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!-- Segmented control + session note -->
            <Grid Margin="0,0,0,8">
                <Border CornerRadius="10" Background="#14000000" Padding="2" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="BrowseSeg" Content="Browse &amp; edit" Style="{StaticResource SegmentBtn}" IsChecked="True" Checked="Segment_Checked"/>
                        <RadioButton x:Name="SqlSeg" Content="SQL console" Style="{StaticResource SegmentBtn}" Checked="Segment_Checked"/>
                        <RadioButton x:Name="HistorySeg" Content="History &amp; saved mods" Style="{StaticResource SegmentBtn}" Checked="Segment_Checked"/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Style="{StaticResource BadgeLive}" Margin="0"><TextBlock Text="Live" Foreground="#1E8E3E" Style="{StaticResource BadgeTxt}"/></Border>
                    <TextBlock Text="Edits apply instantly · last until the game closes · undo any time" FontSize="11" Foreground="#8E8E93" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- ════════ BROWSE ════════ -->
            <Grid x:Name="BrowsePanel" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TableTitle" Text="Pick a table on the left" FontSize="18" FontWeight="Bold" Foreground="#1C1C1E" VerticalAlignment="Center"/>
                    <TextBlock x:Name="RowCountTxt" Grid.Column="1" FontSize="12" Foreground="#8E8E93" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="Refresh" Style="{StaticResource GlassBtn}" Click="Refresh_Click"/>
                </Grid>
                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="FilterBox" Style="{StaticResource GlassTextBox}" FontSize="12" Padding="10,6" FontFamily="Consolas"
                                 TextChanged="FilterBox_TextChanged" KeyDown="FilterBox_KeyDown"/>
                        <TextBlock x:Name="FilterHint" Text="Only show rows where…  e.g.  TorqueDropOffScale1 &gt; 0.5" FontSize="12" Foreground="#8E8E93"
                                   Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <Button Grid.Column="1" Content="Filter" Style="{StaticResource GlassBtn}" Click="ApplyFilter_Click"/>
                    <Button Grid.Column="2" x:Name="ScaleToggleBtn" Content="Scale a column ▾" Style="{StaticResource GlassBtn}" Click="ScaleToggle_Click"/>
                </Grid>
                <DataGrid x:Name="BrowseGrid" Grid.Row="2" Style="{StaticResource GlassGrid}"
                          AutoGeneratingColumn="Grid_AutoGeneratingColumn" CellEditEnding="BrowseGrid_CellEditEnding"/>
                <Border x:Name="ScalePanel" Grid.Row="3" Style="{StaticResource GlassCardSm}" Margin="0,8,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Scale a column" FontSize="13" FontWeight="Bold" Foreground="#1C1C1E" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ScaleColumnCombo" Style="{StaticResource GlassCombo}" SelectionChanged="ScaleInput_Changed"/>
                            <TextBlock Grid.Column="1" Text="×" FontSize="16" FontWeight="Bold" Foreground="#48484A" Margin="10,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="ScaleFactorBox" Grid.Column="2" Style="{StaticResource GlassTextBox}" FontSize="12" Padding="8,5" Text="2" TextChanged="ScaleInput_Changed"/>
                            <TextBlock x:Name="ScalePreviewTxt" Grid.Column="3" FontSize="12" Foreground="#636366" Margin="12,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Button x:Name="ScaleApplyBtn" Grid.Column="4" Content="Apply to game" Style="{StaticResource GlassBtnPrimary}" Click="ScaleApply_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ════════ SQL ════════ -->
            <Grid x:Name="SqlPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="170"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBox x:Name="SqlEditor" Style="{StaticResource GlassTextBox}" FontFamily="Consolas" FontSize="13"
                         AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                         VerticalContentAlignment="Top" PreviewKeyDown="SqlEditor_PreviewKeyDown"/>
                <Grid Grid.Row="1" Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="Run   (Ctrl+Enter)" Style="{StaticResource GlassBtnPrimary}" Click="RunSql_Click"/>
                    <ComboBox x:Name="TemplateCombo" Grid.Column="1" Style="{StaticResource GlassCombo}" Margin="6,3" SelectionChanged="Template_Selected"/>
                    <TextBlock x:Name="SqlMessage" Grid.Column="2" FontSize="12" Foreground="#636366" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="4" Content="Save as mod" Style="{StaticResource GlassBtn}" Click="SaveSqlAsMod_Click"
                            ToolTip="Re-apply this SQL automatically every time the game starts"/>
                </Grid>
                <DataGrid x:Name="SqlGrid" Grid.Row="2" Style="{StaticResource GlassGrid}" IsReadOnly="True" AutoGeneratingColumn="Grid_AutoGeneratingColumn"/>
            </Grid>

            <!-- ════════ HISTORY & MODS ════════ -->
            <ScrollViewer x:Name="HistoryPanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="This session" Style="{StaticResource GroupCaption}" Margin="0,0,0,8"/>
                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock x:Name="NoHistoryTxt" Style="{StaticResource BodyTxt}" Text="No changes yet. Everything you change in the database appears here and can be undone."/>
                            <ItemsControl x:Name="HistoryList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource GlassCardSm}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="#8E8E93"/>
                                                    <TextBlock Text="{Binding State}" FontSize="10" FontWeight="SemiBold" Foreground="#C96F00" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Description}" FontSize="12" FontWeight="SemiBold" Foreground="#1C1C1E" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Sql}" FontSize="11" FontFamily="Consolas" Foreground="#636366" TextTrimming="CharacterEllipsis" MaxHeight="16"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="Save as mod" Style="{StaticResource GlassBtn}" Click="SaveChangeAsMod_Click" Tag="{Binding}"
                                                        ToolTip="Re-apply this change automatically every time the game starts"/>
                                                <Button Grid.Column="3" Content="Undo" Style="{StaticResource GlassBtnRed}" Click="Undo_Click" Tag="{Binding}"
                                                        IsEnabled="{Binding CanUndo}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Saved mods - applied automatically every time the game starts" Style="{StaticResource GroupCaption}"/>
                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock x:Name="NoModsTxt" Style="{StaticResource BodyTxt}" Text="No saved mods. Use 'Save as mod' on a change to keep it across game restarts."/>
                            <ItemsControl x:Name="ModList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource GlassCardSm}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                          ToolTip="Apply on every game start" Click="ModEnabled_Click"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GlassTextBox}"
                                                             FontSize="12" Padding="8,4" LostFocus="ModName_LostFocus" ToolTip="Click to rename"/>
                                                    <TextBlock Text="{Binding Sql}" FontSize="11" FontFamily="Consolas" Foreground="#636366"
                                                               TextTrimming="CharacterEllipsis" MaxHeight="16" Margin="2,4,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="Apply now" Style="{StaticResource GlassBtn}" Click="ApplyMod_Click" Tag="{Binding}"/>
                                                <Button Grid.Column="3" Content="Delete" Style="{StaticResource GlassBtnRed}" Click="DeleteMod_Click" Tag="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
