<UserControl x:Class="FH2ModStudio.Views.CarsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════ CAR LIST (sub-panel) ═══════════ -->
        <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="#30000000">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#B8FFFFFF" Offset="0"/>
                    <GradientStop Color="#98FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="0,12,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid Margin="14,0,14,8">
                    <TextBlock Text="Cars" FontSize="14" FontWeight="Bold" Foreground="#1C1C1E"/>
                    <TextBlock x:Name="CarCountTxt" FontSize="11" Foreground="#8E8E93" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <Grid Grid.Row="1" Margin="12,0,12,8">
                    <TextBox x:Name="SearchBox" Style="{StaticResource GlassTextBox}" FontSize="12" Padding="10,6" TextChanged="SearchBox_TextChanged"/>
                    <TextBlock x:Name="SearchHint" Text="Search name, make, year or class" FontSize="12" Foreground="#8E8E93"
                               Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <StackPanel Grid.Row="2" Margin="12,0,12,8">
                <Button x:Name="DriftDragBtn" Margin="0,0,0,4" Content="Drift &amp; drag parts for all cars"
                        Style="{StaticResource GlassBtn}" FontSize="11" Click="DriftDrag_Click"
                        ToolTip="Adds a drift suspension (drift alignment on the car's race springs, 60° steering lock while installed), drift tyres and drag tyres (FH3's compounds) as new upgrades to every car - the way Forza Motorsport 7 offers them. Saved as a mod, so the game gets them on every start."/>
                <Button Content="Drift setup &amp; tuning ranges…" Style="{StaticResource GlassBtn}" FontSize="11" Click="DriftSetup_Click"
                        ToolTip="Drift suspension camber, toe and steering lock, and the min/max of every tuning slider - in the running game and for the next start"/>
                </StackPanel>
                <ListBox x:Name="CarList" Grid.Row="3" Margin="10,0,10,0" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource MacroListItem}" SelectionChanged="CarList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Media}" FontSize="12" FontWeight="SemiBold" Foreground="#1C1C1E" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#8E8E93" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ═══════════ WORKSPACE ═══════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Empty state -->
            <Border x:Name="EmptyPanel" Grid.RowSpan="3" Style="{StaticResource GlassCard}" Margin="24" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Pick a car" Style="{StaticResource SectionHeading}"/>
                    <TextBlock x:Name="EmptyTxt" Style="{StaticResource BodyTxt}"
                               Text="Choose a car on the left to see and change everything about it - power, weight, gearing, suspension, grip, brakes and more. Works with or without the game running."/>
                </StackPanel>
            </Border>

            <!-- Header -->
            <Border x:Name="HeaderCard" Grid.Row="0" Style="{StaticResource GlassCard}" Margin="12,10,12,4" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="CarTitle" FontSize="20" FontWeight="Bold" Foreground="#1C1C1E"/>
                        <TextBlock x:Name="CarSubtitle" FontSize="12" Foreground="#636366" Margin="0,2,0,8"/>
                        <WrapPanel x:Name="ChipPanel"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <Button x:Name="AddUpgradeBtn" Content="+ Add upgrade" Style="{StaticResource GlassBtnPrimary}" HorizontalAlignment="Right"
                                Margin="0,0,0,8" Click="AddUpgrade_Click" ToolTip="Add a turbo, engine swap, tyre compound, wider tyres, spacers or a new part level (also: right-click the pills)"/>
                        <Border x:Name="ModeBadge" Style="{StaticResource BadgeLive}" HorizontalAlignment="Right" Margin="0">
                            <TextBlock x:Name="ModeTxt" Style="{StaticResource BadgeTxt}"/>
                        </Border>
                        <Border Style="{StaticResource BadgeRestart}" HorizontalAlignment="Right" Margin="0,6,0,0"
                                ToolTip="The game reads a car's data when the car is loaded. Re-select the car in your garage or start an event to feel the change.">
                            <TextBlock Text="Takes effect on next car load" Foreground="#C96F00" Style="{StaticResource BadgeTxt}"/>
                        </Border>
                        <TextBlock x:Name="ModifiedTxt" FontSize="11" Foreground="#007AFF" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Sections + editor -->
            <Grid x:Name="EditorArea" Grid.Row="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <ListBox x:Name="SectionList" Margin="12,4,4,10" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource MacroListItem}" SelectionChanged="SectionList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="#1C1C1E"/>
                                <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="#C96F00">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Badge}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ScrollViewer x:Name="EditorScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="4,4,12,10" ScrollChanged="EditorScroll_ScrollChanged">
                    <StackPanel>
                        <TextBlock x:Name="SectionTitle" FontSize="16" FontWeight="Bold" Foreground="#1C1C1E" Margin="5,0,0,2"/>
                        <TextBlock x:Name="SectionDesc" Style="{StaticResource BodyTxt}" Margin="5,0,0,4"/>
                        <ProgressBar x:Name="LoadProgress" IsIndeterminate="True" Height="4" Margin="5,4" Visibility="Collapsed"/>
                        <StackPanel x:Name="GroupPanel"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Apply bar -->
            <Border x:Name="ApplyBar" Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#25000000" Padding="16,8" Visibility="Collapsed">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#D8FFFFFF" Offset="0"/>
                        <GradientStop Color="#B8FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="DirtyDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DirtyTxt" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <CheckBox x:Name="KeepCheck" Grid.Column="1" IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center"
                              Content="Keep after game restart" ToolTip="Also save this car's changes as a mod that is re-applied every time the game starts."/>
                    <Button Grid.Column="2" x:Name="DiscardBtn" Content="Discard" Style="{StaticResource GlassBtn}" Click="Discard_Click"
                            ToolTip="Throw away the changes you haven't applied yet"/>
                    <Button Grid.Column="3" Content="Reset car to stock" Style="{StaticResource GlassBtnRed}" Click="ResetCar_Click"
                            ToolTip="Put every value of this car back to the factory setting and remove its saved mod"/>
                    <Button Grid.Column="4" x:Name="ApplyBtn" Content="Apply" Style="{StaticResource GlassBtnPrimary}" Padding="26,8" Click="Apply_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
