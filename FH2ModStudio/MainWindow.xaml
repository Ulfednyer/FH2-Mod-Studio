<Window TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Auto" UseLayoutRounding="True" SnapsToDevicePixels="True" x:Class="FH2ModStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FH2ModStudio.Views"
        Title="FH2 Mod Studio"
        Height="760" Width="1180"
        MinHeight="640" MinWidth="980"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        Closed="Window_Closed">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" CornerRadius="0" ClipToBounds="True" BorderThickness="1">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#90FFFFFF" Offset="0"/>
                <GradientStop Color="#20FFFFFF" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border Background="#E8F6F8FA">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition/>
                    <RowDefinition Height="39"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- ═══════════ TITLE BAR ═══════════ -->
                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" MouseDown="TitleBar_MouseDown" Cursor="Arrow">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#D8FFFFFF" Offset="0"/>
                            <GradientStop Color="#B0FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110.5"/>
                            <ColumnDefinition Width="5.5"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,16,0">
                            <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#48484A" Data="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="FH2 Mod Studio" FontSize="13" FontWeight="SemiBold" Foreground="#1C1C1E"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
                            <Button Click="MinimizeBtn_Click" Width="32" Height="24" Margin="2,0" Padding="0" Cursor="Arrow"
                                    BorderThickness="0" Background="Transparent" FocusVisualStyle="{x:Null}" ToolTip="Minimize">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="R" CornerRadius="4" Background="Transparent">
                                            <Viewbox Width="12" Height="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Stroke="#636366" StrokeThickness="1.5" Data="M0,1 H12"/>
                                            </Viewbox>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="R" Property="Background" Value="#20000000"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Click="MaximizeBtn_Click" Width="32" Height="24" Margin="2,0" Padding="0" Cursor="Arrow"
                                    BorderThickness="0" Background="Transparent" FocusVisualStyle="{x:Null}" ToolTip="Maximize">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="R" CornerRadius="4" Background="Transparent">
                                            <Viewbox Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Stroke="#636366" StrokeThickness="1.5" Fill="Transparent" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z"/>
                                            </Viewbox>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="R" Property="Background" Value="#20000000"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Click="CloseBtn_Click" Width="32" Height="24" Margin="2,0" Padding="0" Cursor="Arrow"
                                    BorderThickness="0" Background="Transparent" FocusVisualStyle="{x:Null}" ToolTip="Close">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="R" CornerRadius="4" Background="Transparent">
                                            <Viewbox Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Stroke="#FF3B30" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Data="M0,0 L10,10 M10,0 L0,10"/>
                                            </Viewbox>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="R" Property="Background" Value="#18FF3B30"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="1" Background="#30000000"/>

                <!-- ═══════════ ICON SIDEBAR ═══════════ -->
                <Border Grid.Row="1" Grid.Column="0" Grid.RowSpan="2" BorderThickness="0,0,1,0" BorderBrush="#35000000">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#C0FFFFFF" Offset="0"/>
                            <GradientStop Color="#A0FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button x:Name="HomeTabBtn" Click="HomeTab_Click" Style="{StaticResource SidebarIconBtnActive}" ToolTip="Home - launch the game with mods (Ctrl+1)">
                            <StackPanel>
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#1C1C1E" Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Home" Style="{StaticResource SidebarLabel}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CarsTabBtn" Click="CarsTab_Click" Style="{StaticResource SidebarIconBtn}" ToolTip="Cars - edit any car's power, weight, gearing, suspension, grip and more (Ctrl+2)">
                            <StackPanel>
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#1C1C1E" Data="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Cars" Style="{StaticResource SidebarLabel}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="GraphicsTabBtn" Click="GraphicsTab_Click" Style="{StaticResource SidebarIconBtn}" ToolTip="Graphics - quality, draw distance, motion blur, anti-aliasing (Ctrl+3)">
                            <StackPanel>
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#1C1C1E" Data="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Graphics" Style="{StaticResource SidebarLabel}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="DatabaseTabBtn" Click="DatabaseTab_Click" Style="{StaticResource SidebarIconBtn}" ToolTip="Game database - cars, tuning, events (live SQL) (Ctrl+4)">
                            <StackPanel>
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#1C1C1E" Data="M12 3C7.58 3 4 4.79 4 7v10c0 2.21 3.59 4 8 4s8-1.79 8-4V7c0-2.21-3.58-4-8-4zm6 14c0 .5-2.13 2-6 2s-6-1.5-6-2v-2.23c1.61.78 3.72 1.23 6 1.23s4.39-.45 6-1.23V17zm0-4.55c-1.3.95-3.58 1.55-6 1.55s-4.7-.6-6-1.55V9.64c1.47.83 3.61 1.36 6 1.36s4.53-.53 6-1.36v2.81zM12 9C8.13 9 6 7.5 6 7s2.13-2 6-2 6 1.5 6 2-2.13 2-6 2z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Database" Style="{StaticResource SidebarLabel}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="PortTabBtn" Click="PortTab_Click" Style="{StaticResource SidebarIconBtn}" ToolTip="Port FH3 cars - pick Forza Horizon 3 cars and convert them into the game (Ctrl+5)">
                            <StackPanel>
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#1C1C1E" Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Port cars" Style="{StaticResource SidebarLabel}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ═══════════ WORKSPACE ═══════════ -->
                <Grid Grid.Row="1" Grid.Column="1">
                    <views:HomeView x:Name="HomePage"/>
                    <views:CarsView x:Name="CarsPage" Visibility="Collapsed"/>
                    <views:GraphicsView x:Name="GraphicsPage" Visibility="Collapsed"/>
                    <views:DatabaseView x:Name="DatabasePage" Visibility="Collapsed"/>
                    <views:PortView x:Name="PortPage" Visibility="Collapsed"/>
                </Grid>

                <!-- ═══════════ STATUS BAR ═══════════ -->
                <Border Grid.Row="2" Grid.Column="1" BorderThickness="0,1,0,0" BorderBrush="#25000000">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#C8FFFFFF" Offset="0"/>
                            <GradientStop Color="#A8FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid Margin="5,0,0,0" Height="38" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusTxt" FontSize="11" Foreground="#636366" Margin="4,0,8,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="FH2 Mod Studio - Ready"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0">
                            <Border x:Name="GamePill" Style="{StaticResource StatusPill}" ToolTip="Is Forza Horizon 2 running in Azimuth?">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="GameDot" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="GameTxt" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="ModsPill" Style="{StaticResource StatusPill}" ToolTip="Is the mod DLL loaded into the game?">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="ModsDot" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="ModsTxt" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="DbPill" Style="{StaticResource StatusPill}" ToolTip="Can the game database be edited right now?">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="DbDot" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="DbTxt" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
